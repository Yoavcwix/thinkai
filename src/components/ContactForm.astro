---
// Styling contract: .form-container, .form-field, .form-label, .form-input,
// .form-textarea, .form-button, .form-success, .form-error,
// .form-field-error, .form-input-error
interface Props {
  formTitle?: string;
}

const { formTitle = "Book a Consultation Call" } = Astro.props;
---

<section class="form-container">
  <h2 class="form-heading">{formTitle}</h2>
  <p class="form-subheading">
    Tell me a bit about yourself and what you're hoping to get out of a workshop.
    I'll be in touch within 24 hours.
  </p>

  <form class="form-body">
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="first_name">
          First Name <span class="required">*</span>
        </label>
        <input class="form-input" id="first_name" name="first_name" type="text" required placeholder="Your first name" />
      </div>
      <div class="form-field">
        <label class="form-label" for="last_name">
          Last Name
        </label>
        <input class="form-input" id="last_name" name="last_name" type="text" placeholder="Your last name" />
      </div>
    </div>

    <div class="form-field">
      <label class="form-label" for="email">
        Email <span class="required">*</span>
      </label>
      <input class="form-input" id="email" name="email" type="email" required placeholder="you@example.com" />
    </div>

    <div class="form-field">
      <label class="form-label" for="workshop_interest">
        I'm interested in... <span class="required">*</span>
      </label>
      <input class="form-input" id="workshop_interest" name="workshop_interest" type="text" required placeholder="e.g. AI for my team, beginner workshop..." />
    </div>

    <div class="form-field">
      <label class="form-label" for="message">
        Message
      </label>
      <textarea class="form-textarea" id="message" name="message" rows={4} placeholder="Tell me more about your goals or questions..."></textarea>
    </div>

    <button type="submit" class="form-button">Send Message</button>
  </form>
</section>

<style is:global>
  /* is:global is REQUIRED — scoped styles won't apply after the forms skill
     replaces this placeholder with a React island (<ContactForm client:load>) */

  .form-container {
    max-width: 600px;
  }

  .form-heading {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .form-subheading {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .form-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    font-family: var(--font-body);
  }

  .form-label .required {
    color: var(--color-primary);
    margin-left: 0.2rem;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    /* --color-bg-alt for dark-site visibility (never --color-bg) */
    background: var(--color-bg-alt);
    border: 1px solid color-mix(in srgb, var(--color-text) 20%, transparent);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.7;
  }
  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 15%, transparent);
  }
  .form-input.form-input-error,
  .form-textarea.form-input-error {
    border-color: #f87171;
  }

  .form-textarea { resize: vertical; min-height: 120px; }

  .form-button {
    width: 100%;
    padding: 0.875rem 1.5rem;
    background: var(--color-primary);
    color: var(--color-bg);
    border: none;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0.01em;
  }
  .form-button:hover {
    background: #38E3FF;
    box-shadow: var(--glow-primary);
    transform: translateY(-1px);
  }
  .form-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .form-success {
    padding: 1rem 1.25rem;
    background: rgba(34, 211, 238, 0.1);
    border: 1px solid rgba(34, 211, 238, 0.3);
    border-radius: var(--radius-md);
    color: var(--color-primary);
    font-size: 0.9375rem;
    text-align: center;
  }

  .form-error {
    padding: 0.75rem 1rem;
    background: rgba(248, 113, 113, 0.1);
    border: 1px solid rgba(248, 113, 113, 0.3);
    border-radius: var(--radius-md);
    color: #f87171;
    font-size: 0.875rem;
  }

  .form-field-error {
    font-size: 0.8125rem;
    color: #f87171;
    margin-top: 0.25rem;
  }

  @media (max-width: 520px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
