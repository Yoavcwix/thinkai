---
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;

const links = [
  { href: "/workshops", label: "Workshops" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="site-logo" aria-label="ThinkAI Home">
      <span class="logo-mark">T</span>
      <span class="logo-text">ThinkAI</span>
    </a>

    <ul class="nav-links" role="list">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={["nav-link", { "nav-link--active": currentPath.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <!-- Slot for future auth/cart additions by features skill -->
      <slot name="actions" />
      <a href="/contact" class="nav-cta">Book a Call</a>
    </div>

    <!-- Mobile hamburger -->
    <button class="mobile-menu-btn" aria-label="Toggle menu" id="mobile-menu-btn">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Mobile nav drawer -->
  <div class="mobile-nav" id="mobile-nav" aria-hidden="true">
    <ul role="list">
      {links.map((link) => (
        <li>
          <a href={link.href} class="mobile-nav-link">{link.label}</a>
        </li>
      ))}
      <li><a href="/contact" class="mobile-nav-link mobile-nav-cta">Book a Call</a></li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const open = nav?.getAttribute("aria-hidden") === "false";
    nav?.setAttribute("aria-hidden", open ? "true" : "false");
    btn.classList.toggle("open", !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 13, 27, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(34, 211, 238, 0.1);
  }

  .site-nav {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 4.5rem;
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .logo-mark {
    width: 2rem;
    height: 2rem;
    background: var(--color-primary);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    box-shadow: var(--glow-primary);
  }
  .logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .site-logo:hover .logo-mark {
    box-shadow: var(--glow-primary-strong);
  }
  .site-logo:hover .logo-text {
    color: var(--color-primary);
  }

  /* Nav links */
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-link {
    display: block;
    padding: 0.5rem 0.875rem;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9375rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
  }
  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text);
    background: rgba(34, 211, 238, 0.07);
  }
  .nav-link--active {
    color: var(--color-primary);
  }

  /* Nav CTA */
  .nav-actions { display: flex; align-items: center; gap: 1rem; flex-shrink: 0; }
  .nav-cta {
    padding: 0.5rem 1.25rem;
    background: var(--color-primary);
    color: var(--color-bg);
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.875rem;
    transition: all 0.2s;
    text-decoration: none;
  }
  .nav-cta:hover {
    background: #38E3FF;
    color: var(--color-bg);
    box-shadow: var(--glow-primary);
  }

  /* Mobile hamburger */
  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }
  .mobile-menu-btn span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .mobile-menu-btn.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .mobile-menu-btn.open span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile nav drawer */
  .mobile-nav {
    display: none;
    padding: 1rem 1.5rem 1.5rem;
    border-top: 1px solid rgba(34, 211, 238, 0.1);
    background: rgba(5, 13, 27, 0.97);
  }
  .mobile-nav[aria-hidden="false"] { display: block; }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
  .mobile-nav-link {
    display: block;
    padding: 0.875rem 0;
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(34, 211, 238, 0.07);
    text-decoration: none;
    transition: color 0.15s;
  }
  .mobile-nav-link:hover { color: var(--color-primary); }
  .mobile-nav-cta {
    margin-top: 1rem;
    color: var(--color-primary);
    font-weight: 600;
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .nav-links, .nav-cta { display: none; }
    .mobile-menu-btn { display: flex; }
  }
</style>
