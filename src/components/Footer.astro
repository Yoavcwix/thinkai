---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner section-container">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <span class="footer-logo-mark">T</span>
        <span class="footer-logo-text">ThinkAI</span>
      </a>
      <p class="footer-tagline">
        AI workshops for curious minds.<br />
        Learn to think with AI, not just use it.
      </p>
    </div>

    <div class="footer-links">
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/workshops">Workshops</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/testimonials">Testimonials</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Connect</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Book a Call</a></li>
        </ul>
      </div>
    </div>
  </div>

  <hr class="footer-divider" />

  <div class="footer-bottom section-container">
    <p>&copy; {currentYear} ThinkAI. All rights reserved.</p>
    <p class="footer-built">Built with intention.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-secondary);
    border-top: 1px solid rgba(34, 211, 238, 0.1);
    padding-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
    padding-bottom: 3rem;
  }

  /* Brand block */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .footer-logo-mark {
    width: 2rem;
    height: 2rem;
    background: var(--color-primary);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .footer-logo-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
  }
  .footer-tagline {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
    max-width: 22rem;
  }

  /* Links columns */
  .footer-links {
    display: flex;
    gap: 3.5rem;
  }
  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .footer-col a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-col a:hover { color: var(--color-primary); }

  /* Divider & bottom */
  .footer-divider {
    border: none;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.15), transparent);
    margin: 0;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    color: var(--color-text-muted);
    font-size: 0.825rem;
  }
  .footer-bottom p { margin: 0; }
  .footer-built { color: rgba(148, 163, 184, 0.5); }

  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-links { gap: 2rem; }
    .footer-bottom { flex-direction: column; gap: 0.5rem; text-align: center; }
  }
</style>
