---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import WorkshopCard from "../components/WorkshopCard.astro";
import BlogCard from "../components/BlogCard.astro";

// Placeholder workshops — features skill will replace with CMS data
const featuredWorkshops = [
  {
    title: "AI Fundamentals Intensive",
    description: "Master the mental models behind modern AI. From prompts to agents — no coding required. Perfect for professionals curious about what AI can actually do.",
    format: "Online",
    duration: "Half-day",
    audience: "Beginners",
    price: "$299",
    slug: "ai-fundamentals",
  },
  {
    title: "AI for Your Team",
    description: "A hands-on workshop tailored to your industry and workflows. We identify high-impact use cases and build AI habits your whole team can adopt.",
    format: "In-Person",
    duration: "Full-day",
    audience: "Teams",
    price: "From $1,200",
    slug: "ai-for-teams",
  },
  {
    title: "Executive AI Briefing",
    description: "Cut through the noise. Understand AI risks, opportunities, and what your competitors are doing — in a focused 3-hour session built for leaders.",
    format: "Hybrid",
    duration: "3 hours",
    audience: "Leaders",
    price: "$499",
    slug: "executive-ai-briefing",
  },
];

// Placeholder blog posts — features skill will replace with Wix Blog data
const recentPosts = [
  {
    title: "5 AI Tools That Will Actually Save You Time This Week",
    excerpt: "Not another list of hype tools. These are the five AI workflows I recommend to every workshop participant — practical, tested, and immediately useful.",
    slug: "5-ai-tools-save-time",
    publishedDate: "Apr 8, 2026",
    readingTime: "6 min read",
    tag: "Productivity",
  },
  {
    title: "Why Most AI Prompts Fail (And How to Fix Them)",
    excerpt: "The biggest mistake people make when using AI isn't the tool they choose — it's how they ask. Here's the framework I teach in every workshop.",
    slug: "why-ai-prompts-fail",
    publishedDate: "Apr 1, 2026",
    readingTime: "8 min read",
    tag: "Prompting",
  },
  {
    title: "AI Isn't Coming For Your Job. But This Might Be.",
    excerpt: "The real risk isn't replacement — it's falling behind colleagues and competitors who learn to use AI effectively. Let's talk honestly about what that means.",
    slug: "ai-isnt-coming-for-your-job",
    publishedDate: "Mar 24, 2026",
    readingTime: "5 min read",
    tag: "Big Picture",
  },
];
---

<Layout title="ThinkAI — AI Workshops">
  <Navigation />

  <main>
    <!-- ── Hero ── -->
    <section class="hero grid-bg">
      <div class="hero__inner section-container">
        <div class="hero__content">
          <span class="tag reveal reveal-1">AI Workshops</span>
          <h1 class="hero__headline reveal reveal-2">
            Learn to think<br />
            <em class="hero__headline-em">with</em> AI.
          </h1>
          <p class="hero__subheadline reveal reveal-3">
            Practical, hands-on workshops that turn AI from a buzzword into your most powerful thinking partner. For individuals, teams, and leaders.
          </p>
          <div class="hero__actions reveal reveal-4">
            <a href="/workshops" class="btn-primary">Explore Workshops</a>
            <a href="/contact" class="btn-outline">Book a Free Call</a>
          </div>
        </div>

        <div class="hero__visual reveal reveal-3" aria-hidden="true">
          <div class="hero__orb hero__orb--1"></div>
          <div class="hero__orb hero__orb--2"></div>
          <div class="hero__brain-box">
            <div class="brain-node brain-node--center"></div>
            <div class="brain-node brain-node--1"></div>
            <div class="brain-node brain-node--2"></div>
            <div class="brain-node brain-node--3"></div>
            <div class="brain-node brain-node--4"></div>
            <div class="brain-line brain-line--1"></div>
            <div class="brain-line brain-line--2"></div>
            <div class="brain-line brain-line--3"></div>
            <div class="brain-line brain-line--4"></div>
          </div>
        </div>
      </div>

      <div class="hero__scroll" aria-hidden="true"><span></span></div>
    </section>

    <hr class="section-divider" />

    <!-- ── Social proof bar ── -->
    <section class="trust-bar">
      <div class="trust-bar__inner section-container">
        <div class="trust-stat reveal reveal-1">
          <span class="trust-stat__number">500+</span>
          <span class="trust-stat__label">Participants trained</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-stat reveal reveal-2">
          <span class="trust-stat__number">40+</span>
          <span class="trust-stat__label">Workshops delivered</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-stat reveal reveal-3">
          <span class="trust-stat__number">97%</span>
          <span class="trust-stat__label">Satisfaction rate</span>
        </div>
        <div class="trust-divider" aria-hidden="true"></div>
        <div class="trust-stat reveal reveal-4">
          <span class="trust-stat__number">3</span>
          <span class="trust-stat__label">Workshop formats</span>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── Featured Workshops ── -->
    <section class="featured-workshops">
      <div class="section-container">
        <header class="section-header reveal">
          <span class="accent-rule"></span>
          <h2>Workshops</h2>
          <p>Choose the format that fits your goals and schedule.</p>
        </header>
        <div class="workshops-grid">
          {featuredWorkshops.map((workshop, i) => (
            <div class={`reveal reveal-${i + 1}`}>
              <WorkshopCard {...workshop} />
            </div>
          ))}
        </div>
        <div class="section-cta reveal">
          <a href="/workshops" class="btn-outline">See all workshops →</a>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── Why ThinkAI ── -->
    <section class="why-section grid-bg">
      <div class="section-container">
        <header class="section-header reveal">
          <span class="accent-rule"></span>
          <h2>Why ThinkAI?</h2>
          <p>There's no shortage of AI tutorials. Here's what makes these workshops different.</p>
        </header>
        <div class="why-grid">
          <div class="why-item reveal reveal-1">
            <div class="why-icon">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path d="M11 2L3 7v8l8 5 8-5V7L11 2z" stroke="var(--color-primary)" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M11 2v13M3 7l8 4 8-4" stroke="var(--color-primary)" stroke-width="1.5"/>
              </svg>
            </div>
            <h3>No fluff, no jargon</h3>
            <p>Every session is built around practical skills you can apply the same day. We skip the buzzword bingo.</p>
          </div>
          <div class="why-item reveal reveal-2">
            <div class="why-icon">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <circle cx="11" cy="11" r="9" stroke="var(--color-primary)" stroke-width="1.5"/>
                <path d="M7 11l3 3 5-6" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>Tailored to your world</h3>
            <p>Workshops are adapted to your industry, role, and real use cases — not generic demos.</p>
          </div>
          <div class="why-item reveal reveal-3">
            <div class="why-icon">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path d="M4 6h14M4 11h10M4 16h7" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3>Mental models that stick</h3>
            <p>You'll leave with frameworks for thinking about AI — not just a list of tools that'll change next month.</p>
          </div>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── Recent Blog Posts ── -->
    <section class="blog-section">
      <div class="section-container">
        <header class="section-header reveal">
          <span class="accent-rule"></span>
          <h2>From the Blog</h2>
          <p>Honest takes on AI, learning, and working smarter.</p>
        </header>
        <div class="blog-grid">
          {recentPosts.map((post, i) => (
            <div class={`reveal reveal-${i + 1}`}>
              <BlogCard {...post} />
            </div>
          ))}
        </div>
        <div class="section-cta reveal">
          <a href="/blog" class="btn-outline">Read all posts →</a>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- ── CTA Banner ── -->
    <section class="cta-banner">
      <div class="cta-banner__inner section-container">
        <div class="cta-banner__orb" aria-hidden="true"></div>
        <div class="cta-banner__content reveal">
          <span class="tag tag-amber">Limited spots available</span>
          <h2>Ready to seriously level up with AI?</h2>
          <p>Book a free 20-minute call. We'll figure out which workshop is right for you.</p>
          <a href="/contact" class="btn-primary">Book a Free Call</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Hero */
  .hero {
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 50% at 70% 50%, rgba(34,211,238,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding-top: 5rem;
    padding-bottom: 5rem;
  }
  .hero__content { display: flex; flex-direction: column; gap: 1.5rem; }
  .hero__headline {
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .hero__headline-em {
    font-style: italic;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero__subheadline {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.7;
    max-width: 36rem;
    margin: 0;
  }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero__visual {
    position: relative;
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }
  .hero__orb--1 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(34,211,238,0.12) 0%, transparent 70%);
    top: 10%; left: 10%;
  }
  .hero__orb--2 {
    width: 200px; height: 200px;
    background: radial-gradient(circle, rgba(245,158,11,0.1) 0%, transparent 70%);
    bottom: 10%; right: 10%;
  }
  .hero__brain-box { position: relative; width: 260px; height: 260px; }
  .brain-node {
    position: absolute;
    border-radius: 50%;
    background: var(--color-primary);
    animation: subtleFloat 4s ease-in-out infinite;
  }
  .brain-node--center {
    width: 40px; height: 40px;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: var(--glow-primary-strong);
  }
  .brain-node--1 { width: 18px; height: 18px; top: 10%; left: 20%; opacity: 0.7; animation-delay: 0.5s; }
  .brain-node--2 { width: 14px; height: 14px; top: 15%; right: 15%; opacity: 0.6; background: var(--color-accent); animation-delay: 1s; }
  .brain-node--3 { width: 20px; height: 20px; bottom: 10%; left: 25%; opacity: 0.7; animation-delay: 1.5s; }
  .brain-node--4 { width: 12px; height: 12px; bottom: 20%; right: 20%; opacity: 0.5; animation-delay: 0.8s; }
  .brain-line {
    position: absolute;
    background: linear-gradient(90deg, transparent, rgba(34,211,238,0.25), transparent);
    height: 1px;
  }
  .brain-line--1 { width: 100px; top: 50%; left: 20%; transform: rotate(-25deg); }
  .brain-line--2 { width: 90px; top: 35%; left: 40%; transform: rotate(15deg); }
  .brain-line--3 { width: 80px; bottom: 35%; left: 30%; transform: rotate(-10deg); }
  .brain-line--4 { width: 70px; bottom: 40%; right: 20%; transform: rotate(30deg); }
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
  }
  .hero__scroll span {
    display: block;
    width: 1px; height: 40px;
    background: linear-gradient(to bottom, var(--color-primary), transparent);
    animation: fadeIn 2s ease-in-out infinite alternate;
  }

  /* Trust bar */
  .trust-bar { padding: 3rem 0; }
  .trust-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-wrap: wrap;
  }
  .trust-stat {
    text-align: center;
    padding: 1rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .trust-stat__number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1;
  }
  .trust-stat__label { font-size: 0.8125rem; color: var(--color-text-muted); font-weight: 500; }
  .trust-divider { width: 1px; height: 2.5rem; background: rgba(34,211,238,0.2); }

  /* Sections */
  .featured-workshops, .why-section, .blog-section { padding: var(--space-section) 0; }
  .section-header { margin-bottom: 3rem; }
  .section-header h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: 0.625rem; }
  .section-header p { color: var(--color-text-muted); font-size: 1rem; margin: 0; }
  .section-cta { margin-top: 2.5rem; text-align: center; }

  .workshops-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }

  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .why-item {
    background: var(--color-secondary);
    border: 1px solid rgba(34,211,238,0.1);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .why-icon {
    width: 3rem; height: 3rem;
    background: rgba(34,211,238,0.08);
    border-radius: var(--radius-md);
    display: grid; place-items: center;
    border: 1px solid rgba(34,211,238,0.15);
  }
  .why-item h3 { font-size: 1.0625rem; margin: 0; }
  .why-item p { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.6; margin: 0; }

  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }

  /* CTA Banner */
  .cta-banner {
    padding: var(--space-section) 0;
    background: var(--color-secondary);
    position: relative;
    overflow: hidden;
  }
  .cta-banner__orb {
    position: absolute;
    width: 600px; height: 400px;
    background: radial-gradient(ellipse, rgba(34,211,238,0.08) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .cta-banner__inner { position: relative; }
  .cta-banner__content {
    text-align: center;
    max-width: 560px;
    margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
  }
  .cta-banner__content h2 { font-size: clamp(1.5rem, 2.5vw, 2.25rem); margin: 0; }
  .cta-banner__content p { color: var(--color-text-muted); font-size: 1rem; margin: 0; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__visual { display: none; }
    .why-grid, .blog-grid { grid-template-columns: 1fr 1fr; }
    .trust-divider { display: none; }
    .trust-stat { padding: 1rem 1.5rem; }
  }
  @media (max-width: 600px) {
    .workshops-grid, .why-grid, .blog-grid { grid-template-columns: 1fr; }
    .hero__actions { flex-direction: column; }
    .hero__actions a { width: 100%; text-align: center; justify-content: center; }
  }
</style>
