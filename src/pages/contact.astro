---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  title="Contact"
  description="Book a free consultation call with ThinkAI or send a message about workshops."
>
  <Navigation currentPath="/contact" />

  <main>
    <section class="contact-page grid-bg">
      <div class="section-container">
        <div class="contact-inner">
          <!-- Left: info -->
          <div class="contact-info reveal">
            <span class="tag">Get in Touch</span>
            <h1 class="contact-headline">
              Let's figure out<br />
              <em class="em-gradient">what you need.</em>
            </h1>
            <p class="contact-desc">
              Whether you want to join a public workshop, bring training to your team, or just ask a question — drop me a message. I read every one personally.
            </p>

            <div class="contact-details">
              <div class="contact-detail-item">
                <div class="contact-detail-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <circle cx="9" cy="9" r="7.5" stroke="var(--color-primary)" stroke-width="1.5"/>
                    <path d="M9 5v4l2.5 2.5" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
                <div>
                  <span class="contact-detail-label">Response time</span>
                  <span class="contact-detail-value">Within 1 business day</span>
                </div>
              </div>

              <div class="contact-detail-item">
                <div class="contact-detail-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <rect x="2" y="4" width="14" height="10" rx="2" stroke="var(--color-primary)" stroke-width="1.5"/>
                    <path d="M2 7l7 4.5L16 7" stroke="var(--color-primary)" stroke-width="1.5"/>
                  </svg>
                </div>
                <div>
                  <span class="contact-detail-label">Prefer email?</span>
                  <span class="contact-detail-value">hello@thinkai.co</span>
                </div>
              </div>

              <div class="contact-detail-item">
                <div class="contact-detail-icon">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <path d="M9 2a5 5 0 100 10A5 5 0 009 2z" stroke="var(--color-primary)" stroke-width="1.5"/>
                    <path d="M4 16c0-2.76 2.24-5 5-5s5 2.24 5 5" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>
                <div>
                  <span class="contact-detail-label">Free discovery call</span>
                  <span class="contact-detail-value">20 minutes, no pressure</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: form -->
          <div class="contact-form-wrap reveal reveal-2">
            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .contact-page {
    padding: 7rem 0 var(--space-section);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
  }
  .contact-page::before {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 50% 60% at 70% 40%, rgba(34,211,238,0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: start;
    position: relative;
  }

  /* Info column */
  .contact-info { display: flex; flex-direction: column; gap: 1.5rem; }
  .contact-headline {
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0;
  }
  .em-gradient {
    font-style: italic;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .contact-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75;
    max-width: 36rem;
    margin: 0;
  }

  /* Contact details */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(34,211,238,0.1);
  }
  .contact-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .contact-detail-icon {
    width: 2.5rem;
    height: 2.5rem;
    background: rgba(34,211,238,0.08);
    border: 1px solid rgba(34,211,238,0.15);
    border-radius: var(--radius-md);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .contact-detail-item > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .contact-detail-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .contact-detail-value {
    font-size: 0.9375rem;
    color: var(--color-text);
    font-weight: 500;
  }

  /* Form wrap */
  .contact-form-wrap {
    background: var(--color-secondary);
    border: 1px solid rgba(34,211,238,0.12);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    position: relative;
  }
  .contact-form-wrap::before {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 80% 20%, rgba(34,211,238,0.04) 0%, transparent 60%);
    border-radius: inherit;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .contact-inner { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 600px) {
    .contact-form-wrap { padding: 1.5rem; }
  }
</style>
