---
// CMS-managed page — features skill will replace sampleFaqs with @wix/data query
// and wire up FaqAccordion React island for interactive expand/collapse
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface FaqItem {
  question: string;
  answer: string;
}

// Placeholder — features skill replaces with: const faqs = await queryDataItems(...)
const faqs: FaqItem[] = [
  {
    question: "Do I need to know how to code?",
    answer: "No. Most of my workshops require zero technical background. The AI Fundamentals, Prompt Engineering, and Executive Briefing workshops are all designed for non-developers. I do have one workshop (Build Your First AI Agent) that assumes basic tech comfort, but it's clearly labelled.",
  },
  {
    question: "How are the workshops delivered?",
    answer: "I offer online, in-person, and hybrid formats depending on the workshop. Online workshops use video conferencing with shared exercises. In-person workshops are held at a venue you arrange or I can recommend. All formats are interactive — not just lectures.",
  },
  {
    question: "Can you customise a workshop for my team?",
    answer: "Yes, absolutely. Team workshops are always customised to your industry, tools, and specific goals. I'll do a brief discovery call before the session to understand your context and tailor the content accordingly. Get in touch via the contact page to discuss.",
  },
  {
    question: "What's the maximum group size?",
    answer: "For public workshops, groups are capped at 20 people to keep sessions interactive. For private team sessions, I've worked with groups of up to 60, though I typically recommend splitting larger teams into smaller cohorts for better outcomes.",
  },
  {
    question: "What's your cancellation policy?",
    answer: "For public workshops, cancellations made more than 7 days before the session receive a full refund. Within 7 days, you can transfer to another session date. For private team bookings, please see the terms in your booking confirmation.",
  },
  {
    question: "How long have you been running these workshops?",
    answer: "I've been running AI training sessions since 2023, and have worked with over 500 participants from startups, enterprise teams, freelancers, and C-suite leaders. The workshops have evolved significantly as AI tools have developed.",
  },
  {
    question: "Will the content go out of date quickly?",
    answer: "I update workshop content regularly — every major AI release gets factored in. More importantly, I focus on principles and mental models rather than specific products. That means the frameworks you learn will still be useful even as the tools change.",
  },
  {
    question: "Do you offer a certificate or proof of completion?",
    answer: "Yes. Participants receive a digital certificate of completion for every workshop. These are good for LinkedIn, CPD records, or professional portfolios.",
  },
];
---

<Layout
  title="FAQ"
  description="Answers to common questions about ThinkAI workshops."
>
  <Navigation currentPath="/faq" />

  <main>
    <!-- Hero -->
    <section class="faq-hero grid-bg">
      <div class="section-container">
        <div class="faq-hero__content reveal">
          <span class="tag">FAQ</span>
          <h1>
            Questions?<br />
            <em class="em-gradient">Good.</em>
          </h1>
          <p>Here are the ones I get most often. If yours isn't here, just ask.</p>
          <a href="/contact" class="btn-outline">Ask a question →</a>
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- FAQ list — FaqAccordion React island will be wired here by features skill -->
    <section class="faq-list-section">
      <div class="section-container">
        <div class="faq-list" id="faq-accordion">
          {faqs.map((faq, i) => (
            <div class={`faq-item reveal reveal-${(i % 3) + 1}`} data-faq-item>
              <button class="faq-question" aria-expanded="false" data-faq-btn>
                <span>{faq.question}</span>
                <svg class="faq-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                  <path d="M4 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <div class="faq-answer" aria-hidden="true">
                <p>{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <hr class="section-divider" />

    <!-- Still have questions? -->
    <section class="faq-contact-cta">
      <div class="section-container">
        <div class="faq-contact-cta__inner reveal">
          <h2>Still have a question?</h2>
          <p>I read every message personally and usually respond within a business day.</p>
          <a href="/contact" class="btn-primary">Get in Touch</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  // Basic accordion for visual preview — features skill will replace with FaqAccordion React island
  document.querySelectorAll("[data-faq-btn]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest("[data-faq-item]");
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      // Close all
      document.querySelectorAll("[data-faq-btn]").forEach((b) => {
        b.setAttribute("aria-expanded", "false");
        b.closest("[data-faq-item]")?.querySelector(".faq-answer")?.setAttribute("aria-hidden", "true");
      });
      // Open this one if it was closed
      if (!isOpen) {
        btn.setAttribute("aria-expanded", "true");
        item?.querySelector(".faq-answer")?.setAttribute("aria-hidden", "false");
      }
    });
  });
</script>

<style>
  .faq-hero {
    padding: 8rem 0 4rem;
    position: relative;
    overflow: hidden;
  }
  .faq-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 40% 60% at 60% 50%, rgba(34,211,238,0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  .faq-hero__content {
    max-width: 480px;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .faq-hero__content h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
  }
  .em-gradient {
    font-style: italic;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .faq-hero__content p { color: var(--color-text-muted); font-size: 1rem; margin: 0; }

  /* FAQ list */
  .faq-list-section { padding: var(--space-section) 0; }
  .faq-list {
    max-width: 760px;
    margin: 0 auto;
    display: flex; flex-direction: column;
    border-top: 1px solid rgba(34,211,238,0.1);
  }

  .faq-item { border-bottom: 1px solid rgba(34,211,238,0.1); }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    transition: color 0.15s;
  }
  .faq-question:hover { color: var(--color-primary); }
  .faq-question[aria-expanded="true"] { color: var(--color-primary); }
  .faq-question[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.25s ease, color 0.15s;
  }

  .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.3s ease;
  }
  .faq-answer[aria-hidden="false"] { max-height: 400px; }
  .faq-answer p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
    padding-bottom: 1.5rem;
    margin: 0;
  }

  /* CTA */
  .faq-contact-cta { padding: var(--space-section) 0; }
  .faq-contact-cta__inner {
    background: var(--color-secondary);
    border: 1px solid rgba(34,211,238,0.15);
    border-radius: var(--radius-xl);
    padding: 3.5rem;
    text-align: center;
    display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
    position: relative; overflow: hidden;
  }
  .faq-contact-cta__inner::before {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, rgba(34,211,238,0.05) 0%, transparent 70%);
    pointer-events: none;
  }
  .faq-contact-cta__inner h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); margin: 0; position: relative; }
  .faq-contact-cta__inner p { color: var(--color-text-muted); margin: 0; position: relative; }
  .faq-contact-cta__inner .btn-primary { position: relative; }

  @media (max-width: 600px) {
    .faq-contact-cta__inner { padding: 2rem; }
  }
</style>
